#!/usr/bin/env bash
# Render a Wander environment-aware Kubernetes manifest.

set -euo pipefail

# shellcheck disable=SC2016 # jq variables must remain literal for yq/jq to evaluate.
readonly PROGRAM='.
  as $manifest
  | (($manifest["wander-deployment-env"] // {})[$ENV["TILTENV"] // empty] // {}) as $fallback_overrides
  | ((.["wander-env"] // {})[$ENV["TILTENV"] // empty] // {}) as $spec
  | $manifest
  | .["wander-env"] |= empty | .["wander-deployment-env"] |= empty
  | ( . * ($spec | .container_overrides |= empty))
  | if .spec.template.spec.containers != null then
      .spec.template.spec.containers |= map(. as $container
        | ( $spec.container_overrides[$container.name] // {} ) as $overrides
        | ( $container * $fallback_overrides * $overrides )
        | if $images[$container.name] != null then (.image |= $images[$container.name]) else . end
      )
    else . end
  | . * $extra_overrides'

usage() {
  cat <<'EOF'
Usage: wtpl --env ENVIRONMENT --file MANIFEST [OPTIONS]

Render a Kubernetes manifest using its wander-env and wander-deployment-env
overrides. The result is written to standard output unless --out is supplied.

Required arguments:
  --env ENVIRONMENT        Environment to select from the manifest.
  --file MANIFEST          YAML manifest to render.

Optional arguments:
  --images JSON            Object mapping container names to image references.
                           Defaults to {}.
  --extra-overrides JSON   Object deep-merged into the rendered manifest.
                           Defaults to {}.
  --out FILE               Write atomically to FILE instead of standard output.
  --help                   Show this help text.
EOF
}

die() {
  printf 'wtpl: %s\n' "$*" >&2
  exit 2
}

require_json_object() {
  local value=$1
  local option=$2

  jq --exit-status 'type == "object"' >/dev/null <<<"$value" || die "$option must be a JSON object"
}

env_name=''
manifest=''
images='{}'
extra_overrides='{}'
out=''

while (($# > 0)); do
  case $1 in
    --env)
      (($# >= 2)) || die '--env requires a value'
      env_name=$2
      shift 2
      ;;
    --file)
      (($# >= 2)) || die '--file requires a value'
      manifest=$2
      shift 2
      ;;
    --images)
      (($# >= 2)) || die '--images requires a value'
      images=$2
      shift 2
      ;;
    --extra-overrides)
      (($# >= 2)) || die '--extra-overrides requires a value'
      extra_overrides=$2
      shift 2
      ;;
    --out)
      (($# >= 2)) || die '--out requires a value'
      out=$2
      shift 2
      ;;
    --help)
      usage
      exit 0
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
done

[[ -n $env_name ]] || die '--env is required'
[[ -n $manifest ]] || die '--file is required'
[[ -r $manifest ]] || die "cannot read manifest: $manifest"
command -v yq >/dev/null || die 'yq is required'
command -v jq >/dev/null || die 'jq is required'
require_json_object "$images" '--images'
require_json_object "$extra_overrides" '--extra-overrides'

render() {
  TILTENV=$env_name yq -y --argjson images "$images" --argjson extra_overrides "$extra_overrides" "$PROGRAM" <"$manifest"
}

if [[ -z $out ]]; then
  render
  exit 0
fi

out_dir=$(dirname -- "$out")
[[ -d $out_dir ]] || die "output directory does not exist: $out_dir"
tmp=$(mktemp "$out_dir/.wtpl.XXXXXX")
trap 'rm -f -- "$tmp"' EXIT
render >"$tmp"
mv -- "$tmp" "$out"
trap - EXIT
